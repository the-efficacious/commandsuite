{
  "name": "csuite-core",
  "version": "0.7.0",
  "description": "Runtime-agnostic broker logic for csuite — agent registry, push fanout, SSE, event log.",
  "license": "Apache-2.0",
  "author": "Efficacious, Inc.",
  "homepage": "https://github.com/the-efficacious/commandsuite#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/the-efficacious/commandsuite.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/the-efficacious/commandsuite/issues"
  },
  "keywords": [
    "csuite",
    "mcp",
    "agent",
    "agent-control-plane",
    "broker",
    "event-bus"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./conformance": {
      "types": "./dist/conformance/index.d.ts",
      "import": "./dist/conformance/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/.build-stamp.json"
  ],
  "scripts": {
    "build": "tsup && node ../../scripts/dist-stamp.mjs",
    "dev": "tsup --watch",
    "typecheck": "node ../../scripts/check-runtime-neutral.mjs . && tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "node ../../scripts/publish-gate.mjs check",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "csuite-sdk": "workspace:*",
    "hono": "^4.12.31",
    "jose": "^6.2.4",
    "otpauth": "^9.5.1",
    "p-limit": "^7.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "vitest": ">=4"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  }
}
