{
  "name": "csuite-cli",
  "version": "0.7.1",
  "description": "CLI for csuite — wrap agents with csuite claude-code, push objectives, manage the team.",
  "license": "Apache-2.0",
  "author": "Efficacious, Inc.",
  "homepage": "https://github.com/the-efficacious/commandsuite#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/the-efficacious/commandsuite.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/the-efficacious/commandsuite/issues"
  },
  "keywords": [
    "csuite",
    "cli",
    "mcp",
    "agent",
    "agent-control-plane"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "csuite": "./dist/index.js"
  },
  "files": [
    "dist",
    "!dist/.build-stamp.json"
  ],
  "scripts": {
    "build": "tsup && node ../../scripts/dist-stamp.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "node ../../scripts/publish-gate.mjs check",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "csuite-core": "workspace:*",
    "csuite-sdk": "workspace:*",
    "@anthropic-ai/claude-agent-sdk": "^0.3.227",
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "peerDependencies": {
    "csuite-server": ">=0.0.1"
  },
  "peerDependenciesMeta": {
    "csuite-server": {
      "optional": true
    }
  },
  "devDependencies": {
    "@the-efficacious/brand": "^0.2.0",
    "csuite-server": "workspace:*",
    "@types/node": "^26.2.0",
    "@types/ws": "^8.18.1",
    "tsup": "^8.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "ws": "^8.21.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
