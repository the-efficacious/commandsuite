---
import { MARK_ASPECT, MARK_VIEWBOX, brand, markFill } from '../brand/brand.ts';

const markWidth = 24;
const markHeight = Math.round(markWidth * MARK_ASPECT);

// The wordmark is two-tone, split at the internal capital —
// Command|Suite — per the pack's drawing (wordmark-dark/-light).
const splitAt = brand.name.search(/(?<=.)[A-Z]/);
const wordLead = splitAt > 0 ? brand.name.slice(0, splitAt) : brand.name;
const wordAccent = splitAt > 0 ? brand.name.slice(splitAt) : '';
---

<header class="docs-header">
  <div class="docs-header-inner">
    <a href="/" class="lockup" aria-label={`${brand.name} docs`}>
      <svg
        width={markWidth}
        height={markHeight}
        viewBox={MARK_VIEWBOX}
        fill="none"
        class="lockup-mark"
        aria-hidden="true"
      >
        {
          brand.mark.shapes.map((s) =>
            s.kind === 'path' ? <path d={s.d} fill={markFill(s.fill)} /> : null
          )
        }
      </svg>
      <span class="lockup-name">{wordLead}<span class="lockup-name-accent">{wordAccent}</span></span>
      <span class="lockup-divider"></span>
      <span class="lockup-section">Docs</span>
    </a>
    <nav class="nav">
      <a href={brand.homeUrl}>Home</a>
      <a href={brand.ossRepo}>GitHub</a>
    </nav>
  </div>
</header>

<style>
  .docs-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: color-mix(in srgb, var(--ef-surface) 84%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--ef-border-subtle);
  }

  .docs-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 60px;
    padding: 0 var(--ef-layout-edge);
    max-width: var(--ef-layout-max);
    margin: 0 auto;
  }

  .lockup {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: var(--ef-text-lead);
  }

  .lockup-mark {
    flex-shrink: 0;
    /* Center the mark on the logotype's cap height, not its line box —
       Rajdhani reserves descender depth the word never uses (GUIDE §03). */
    transform: translateY(-0.055em);
  }

  /* The logotype is Rajdhani 700, mixed case — never uppercase.
     Two-tone per the pack's wordmark: lead warm white, "Suite" gold.
     Artwork, not chrome, so it sits outside the Tier 1 budget. */
  .lockup-name {
    font-family: var(--ef-font-display);
    font-weight: var(--ef-weight-bold);
    letter-spacing: var(--ef-track-logotype);
    color: var(--wordmark-lead, var(--ef-text));
  }

  .lockup-name-accent {
    color: var(--wordmark-accent);
  }

  .lockup-divider {
    width: 1px;
    height: 16px;
    background: var(--ef-border);
  }

  .lockup-section {
    font-family: var(--ef-font-mono);
    font-size: var(--ef-text-tag-lg);
    letter-spacing: var(--ef-track-tag-mid);
    text-transform: uppercase;
    color: var(--ef-text-muted);
  }

  /* Bare text defers: muted, brightening to text on hover. Never gold. */
  .nav {
    display: flex;
    align-items: center;
    gap: var(--ef-space-lg);
    font-family: var(--ef-font-mono);
    font-size: var(--ef-text-tag-lg);
    letter-spacing: var(--ef-track-tag-tight);
    text-transform: uppercase;
  }

  .nav a {
    color: var(--ef-text-muted);
    transition: color var(--ef-motion-base) var(--ef-motion-ease);
  }

  .nav a:hover {
    color: var(--ef-text);
  }

  @media (max-width: 699px) {
    .docs-header-inner {
      padding: 0 var(--ef-space-lg);
    }
    .lockup-divider,
    .lockup-section {
      display: none;
    }
  }
</style>
