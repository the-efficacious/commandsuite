---
import type { NavSection } from '../lib/nav.ts';

interface Props {
  sections: NavSection[];
  currentSlug?: string;
}

const { sections, currentSlug } = Astro.props;
---

<nav class="docs-sidebar" aria-label="Documentation sections">
  {
    sections.map((section) => (
      <div class="section">
        <h3 class="section-title">{section.name}</h3>
        <ul class="section-list">
          {section.entries.map((entry) => {
            const isActive = entry.slug === currentSlug;
            return (
              <li>
                <a
                  href={`/${entry.slug}`}
                  class:list={['entry-link', { active: isActive }]}
                  aria-current={isActive ? 'page' : undefined}
                >
                  {entry.title}
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    ))
  }
</nav>

<style>
  .docs-sidebar {
    position: sticky;
    top: calc(60px + 24px);
    max-height: calc(100vh - 60px - 24px);
    overflow-y: auto;
    padding: 28px 16px 28px 0;
    /* Ghost scrollbar — marginalia, never primary. */
    scrollbar-width: thin;
    scrollbar-color: var(--ef-scroll-thumb) transparent;
  }
  .docs-sidebar::-webkit-scrollbar {
    width: 6px;
  }
  .docs-sidebar::-webkit-scrollbar-track {
    background: transparent;
  }
  .docs-sidebar::-webkit-scrollbar-thumb {
    background: transparent;
    border-radius: var(--ef-radius-pill);
    transition: background var(--ef-motion-slow);
  }
  .docs-sidebar:hover::-webkit-scrollbar-thumb {
    background: var(--ef-scroll-thumb);
  }

  .section {
    margin-bottom: 28px;
  }

  /* Uppercase is the monospace's job. */
  .section-title {
    font-family: var(--ef-font-mono);
    font-size: var(--ef-text-tag);
    font-weight: var(--ef-weight-medium);
    letter-spacing: var(--ef-track-tag);
    text-transform: uppercase;
    color: var(--ef-text-muted);
    margin-bottom: 12px;
    padding-left: 14px;
  }

  .section-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .entry-link {
    display: block;
    padding: 7px 14px;
    font-family: var(--ef-font-body);
    font-size: 14px;
    color: var(--ef-text-tertiary);
    transition:
      color var(--ef-motion-fast) var(--ef-motion-ease),
      background var(--ef-motion-fast) var(--ef-motion-ease);
  }

  .entry-link:hover {
    color: var(--ef-text);
    background: var(--ef-surface-panel);
  }

  /* Selected: sunken fill + a 3px gold assert bar flush against the
     edge — the ledger's pinned-row treatment, same as the product nav.
     One mark, once per view, inside the Tier 1 budget. Inset shadow
     rather than border-left so the bar doesn't shift the baseline. */
  .entry-link.active {
    color: var(--ef-text);
    font-weight: var(--ef-weight-semibold);
    background: var(--ef-surface-sunken);
    box-shadow: inset 3px 0 0 var(--ef-assert);
  }
</style>
