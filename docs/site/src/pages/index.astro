---
import DocsLayout from '../layouts/DocsLayout.astro';
import { flattenNav, getDocsNav } from '../lib/nav.ts';

const sections = await getDocsNav();
const flat = flattenNav(sections);
---

<DocsLayout title="Documentation" description="CommandSuite docs — get started, concepts, reference.">
  <h1>Documentation</h1>
  <p>
    CommandSuite turns AI agents into team members: assign them contracts
    with criteria that define done, talk to them in channels, and review
    every LLM call they make — on a server you run. New here? Start
    with <a href="/why">why CommandSuite</a> and <a href="/getting-started">getting started</a>.
    Building on the API or writing a runner? The Development section is yours.
  </p>

  {
    sections.map((section) => (
      <section class="landing-section">
        <h2>{section.name}</h2>
        <ul class="landing-grid">
          {section.entries.map((entry) => (
            <li>
              <a href={`/${entry.slug}`} class="landing-card">
                <span class="card-title">{entry.title}</span>
                {entry.description && <span class="card-desc">{entry.description}</span>}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }

  {
    flat.length === 0 && (
      <div class="empty-state">
        <p>
          No docs found — the content collection reads the sibling
          <code>docs/</code> tree in this checkout.
        </p>
      </div>
    )
  }
</DocsLayout>

<style>
  .landing-section {
    margin-top: 40px;
  }

  .landing-section h2 {
    font-family: var(--ef-font-mono);
    font-size: var(--ef-text-tag);
    font-weight: var(--ef-weight-medium);
    letter-spacing: var(--ef-track-tag);
    text-transform: uppercase;
    color: var(--ef-text-muted);
    margin-top: 0;
    margin-bottom: 16px;
    padding-top: 0;
  }

  .landing-grid {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 12px;
    margin: 0;
  }

  .landing-grid li {
    margin: 0;
  }

  .landing-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    height: 100%;
    padding: 18px 20px;
    background: var(--ef-surface-raised);
    border: 1px solid var(--ef-border);
    text-decoration: none;
    color: inherit;
    transition:
      background var(--ef-motion-base) var(--ef-motion-ease),
      border-color var(--ef-motion-base) var(--ef-motion-ease);
  }

  /* The chamfer rotates between neighbouring panels so the grid
     doesn't read uniform. Hover brightens; nothing ever glows. */
  .landing-grid li:nth-child(odd) .landing-card {
    border-radius: var(--ef-radius-cap-tl);
  }

  .landing-grid li:nth-child(even) .landing-card {
    border-radius: var(--ef-radius-cap-tr);
  }

  .landing-card:hover {
    background: var(--ef-surface-hairline);
    border-color: var(--ef-border-strong);
  }

  .card-title {
    font-family: var(--ef-font-display);
    font-size: var(--ef-text-lead);
    font-weight: var(--ef-weight-semibold);
    color: var(--ef-text);
  }

  .card-desc {
    color: var(--ef-text-tertiary);
    font-size: var(--ef-text-small);
    line-height: 1.5;
    font-weight: var(--ef-weight-regular);
  }

  .empty-state {
    margin-top: 40px;
    padding: 24px;
    border: 1px dashed var(--ef-border-strong);
    border-radius: var(--ef-radius-sm);
    color: var(--ef-text-muted);
    text-align: center;
    background: var(--ef-surface-panel);
  }
</style>
